<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sashapaskal.phonefarm.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>--env-file-if-exists=.env</string>
        <string>--env-file-if-exists=.env.devices</string>
        <string>--import</string>
        <string>tsx</string>
        <string>src/api/server.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/sashapaskal/mac-farm-controller</string>
    <key>KeepAlive</key>
    <true/>
    <key>RestartInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/phonefarm-web.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/phonefarm-web.log</string>
</dict>
</plist>
