<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sashapaskal.phonefarm.appium</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>node_modules/appium/index.js</string>
        <string>--address</string>
        <string>127.0.0.1</string>
        <string>--base-path</string>
        <string>/</string>
        <string>--port</string>
        <string>4725</string>
        <string>--log-level</string>
        <string>info</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>APPIUM_HOME</key>
        <string>.appium2</string>
        <key>HOME</key>
        <string>/Users/sashapaskal</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/sashapaskal/mac-farm-controller</string>
    <key>KeepAlive</key>
    <true/>
    <key>RestartInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/phonefarm-appium.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/phonefarm-appium.log</string>
</dict>
</plist>
